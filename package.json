{
  "name": "labor-case-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && node index.js",
    "build": "vite build",
    "build:prod": "npm run build && cd server && NODE_ENV=production node index.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
