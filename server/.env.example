# Server port (default: 4000)
PORT=4000

# JWT secret – CHANGE THIS to a long random string in production
JWT_SECRET=replace-with-a-long-random-secret-string

# CORS origin – Vite dev server URL (change if running on different host/port)
CORS_ORIGIN=http://localhost:3000

# Set to 'production' when serving the built frontend from this server
# NODE_ENV=production
